# Kolejarz Backend — wymagane zmienne środowiskowe
# Skopiuj: cp .env.example .env
# Ten plik NIE zawiera prawdziwych sekretów — jest bezpieczny do commitowania
# Pełny audyt i rotacja: docs/SECRETS_AUDIT.md
# Bootstrap: bash scripts/setup-local-env.sh

PORT=3000
DATABASE_URL=file:./dev.db
NODE_ENV=development

# Klucz API PLK — wymagany do wyszukiwania pociągów i rozkładów stacyjnych
# Otrzymaj od maintainera / dostawcy (nie umieszczaj w repo, nie wklejaj do chatu)
PLK_API_KEY=

# Klucz szyfrowania haseł portalu IVU w bazie danych
# Musi być dokładnie 32 bajty = 64 znaki hex
# Wygeneruj: openssl rand -hex 32
# UWAGA: zmiana klucza na VPS unieważnia zaszyfrowane hasła — wymagana ponowna rejestracja
ENCRYPTION_KEY=

# Ścieżka do Chromium (Playwright / potwierdzanie kart pracy)
# VPS Ubuntu: /usr/bin/chromium
# Mac (po npx playwright install chromium): ustaw ścieżkę executable
# Opcjonalne — bez tego timecard confirm nie działa, reszta tak
CHROMIUM_PATH=

# Publiczny URL backendu — używany np. w odpowiedziach API / release
APP_PUBLIC_URL=http://localhost:3000

# Lista dozwolonych originsów CORS (opcjonalne, puste = otwarte)
# CORS_ORIGINS=http://localhost:3000,exp://192.168.1.100:8081

# Legacy — tylko stare ścieżki bez tenanta (defaultPortalUser). Preferuj rejestrację w appce.
# PORTAL_USER=
# PORTAL_PASSWORD=
