# Kolejarz Backend — wymagane zmienne środowiskowe
# Skopiuj ten plik jako .env i uzupełnij wartości
# Ten plik NIE zawiera prawdziwych sekretów — jest bezpieczny do commitowania

PORT=3000
DATABASE_URL=file:./dev.db
NODE_ENV=production

# Klucz API PLK — wymagany do wyszukiwania pociągów i rozkładów stacyjnych
# Otrzymaj od maintainera projektu (nie umieszczaj w repo)
PLK_API_KEY=

# Klucz szyfrowania haseł portalu IVU w bazie danych
# Musi być dokładnie 32 bajty = 64 znaki hex
# Wygeneruj: openssl rand -hex 32
ENCRYPTION_KEY=

# Ścieżka do Chromium (wymagane tylko dla Playwright / potwierdzania kart pracy)
# Na Ubuntu VPS z apt: /usr/bin/chromium
# Opcjonalne — bez Chromium timecard confirm nie działa, reszta tak
CHROMIUM_PATH=

# Publiczny URL backendu — używany np. w odpowiedziach API
APP_PUBLIC_URL=http://<VPS_IP>:3000

# Lista dozwolonych originsów CORS (opcjonalne, puste = otwarte)
# Format: adres1,adres2
# CORS_ORIGINS=http://localhost:3000,exp://192.168.1.100:8081
