{
  "expo": {
    "name": "Kolejarz",
    "slug": "mind-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.ygor.kolejarz",
      "supportsTablet": true,
      "entitlements": {},
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "57.128.246.232": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        },
        "LSApplicationQueriesSchemes": [
          "altstore"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c83d9f0e-ef99-4d8f-8d3d-158753376461",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.ygor.kolejarz"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kolejarz",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kolejarz używa Face ID do szybkiego logowania."
        }
      ],
      "expo-updates",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#007AFF"
        }
      ],
      [
        "expo-network-security-config",
        {
          "networkSecurityConfig": "./network-security-config.xml",
          "enable": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c83d9f0e-ef99-4d8f-8d3d-158753376461"
      }
    },
    "owner": "ygoor0000"
  }
}
