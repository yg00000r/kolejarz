# Kolejarz App — zmienne środowiskowe (opcjonalne)
#
# DRUGI DEWELOPER NIE MUSI TWORZYĆ TEGO PLIKU do pracy z produkcyjnym VPS.
# Domyślny URL jest w constants/api.ts.
#
# Skopiuj: cp .env.example .env
# Po zmianie zrestartuj Metro (Expo).

# Lokalny backend na Macu — z telefonu użyj IP LAN Maca, nie localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.40:3000

# Symulator iOS / web na tym samym Macu:
# EXPO_PUBLIC_API_URL=http://localhost:3000
